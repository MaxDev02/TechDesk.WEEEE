@model Device
<tr>
    <td>@Model.AssetTag</td><td><a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></td><td>@Model.Category</td><td>@Model.PurchaseYear</td>
    <td>@(Model.IsOnLoan ? "On loan" : "Available")</td>
    <td class="text-nowrap"><a asp-action="Details" asp-route-id="@Model.Id">Details</a> · <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@Model.Id">Delete</a></td>
</tr>
