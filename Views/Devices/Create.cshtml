@model Device
@{ ViewData["Title"] = "Add device"; }
<h1>Add a device</h1><p class="text-muted">Enter the details below. Required fields are checked before saving.</p>
<form asp-action="Create" method="post"><partial name="_DeviceForm" model="Model" /><button type="submit" class="btn btn-primary">Save device</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
