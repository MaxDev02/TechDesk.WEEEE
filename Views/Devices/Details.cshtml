@model Device
@{ ViewData["Title"] = "Device details"; }
<h1>Device details</h1>
<dl class="row"><dt class="col-sm-3">Asset tag</dt><dd class="col-sm-9">@Model.AssetTag</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd><dt class="col-sm-3">Year bought</dt><dd class="col-sm-9">@Model.PurchaseYear</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsOnLoan ? "On loan" : "Available")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
