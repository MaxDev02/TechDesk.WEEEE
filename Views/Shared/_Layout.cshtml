<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechDesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header><nav class="navbar navbar-expand-sm navbar-dark bg-dark"><div class="container">
        <a class="navbar-brand" asp-controller="Devices" asp-action="Index">TechDesk</a>
        <div class="navbar-nav"><a class="nav-link" asp-controller="Devices" asp-action="Index">Devices</a><a class="nav-link" asp-controller="Devices" asp-action="Create">Add device</a></div>
    </div></nav></header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="border-top text-muted py-3"><div class="container">TechDesk · College IT device records</div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
